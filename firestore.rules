rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any logged-in user can read profiles, only owner can write
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Conversations
    match /conversations/{convId} {
      // Allow read only if you are a participant
      allow read: if request.auth != null
                  && resource != null
                  && request.auth.uid in resource.data.participants;

      // Allow create if you include yourself in participants
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // Allow update/delete if you are an existing participant
      allow update, delete: if request.auth != null
                    && resource != null
                    && request.auth.uid in resource.data.participants;

      // Messages sub-collection
      match /messages/{msgId} {
        // Any authenticated user can read messages in a conversation they know
        allow read: if request.auth != null;

        // Only the sender can create a message
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId;

        // Only the original sender can delete their own message
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;

        allow update: if false; // messages are immutable; read receipts live in RTDB
      }
    }
  }
}